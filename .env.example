# ==============================================================================
# SOCIÁLNÍ MÉDIA - API KLÍČE A TOKENY
# ==============================================================================
# Zkopíruj tento soubor na .env a vyplň své skutečné klíče
# ⚠️ NIKDY nepushuj .env s reálnými klíči do gitu!
# ==============================================================================

# --- REDDIT API ---
# Jak získat klíče:
# 1. Jdi na https://www.reddit.com/prefs/apps
# 2. Vytvoř "script" aplikaci
# 3. Zkopíruj client_id a client_secret
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=ProjectInfinit/1.0 (by YourUsername)

# --- YOUTUBE DATA API v3 ---
# Jak získat API klíč:
# 1. Jdi na https://console.cloud.google.com/
# 2. Vytvoř projekt nebo vyber existující
# 3. Aktivuj "YouTube Data API v3" v APIs & Services > Library
# 4. Vytvoř API klíč v APIs & Services > Credentials
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- TELEGRAM API ---
# Jak získat credentials:
# 1. Jdi na https://my.telegram.org/auth
# 2. Přihlaš se telefonem a získej SMS kód
# 3. Jdi na "API development tools"
# 4. Vytvoř aplikaci a zkopíruj api_id a api_hash
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash
TELEGRAM_PHONE=+420...  # Tvůj telefon ve formátu +420XXXXXXXXX

# --- MASTODON API ---
# Jak získat access token:
# 1. Přihlaš se na Mastodon instanci (např. https://mastodon.social)
# 2. Jdi na Settings > Development > New Application
# 3. Vytvoř aplikaci s read:statuses a read:search scopes
# 4. Zkopíruj access token
MASTODON_ACCESS_TOKEN=your_mastodon_access_token
MASTODON_API_BASE_URL=https://mastodon.social

# --- DATABÁZE (nepovinné, výchozí SQLite) ---
# DB_URI=sqlite:///data/project_infinit.db
DB_URI=postgresql://user:password@localhost:5432/nrm_database

# --- LOGLEVEL (DEBUG, INFO, WARNING, ERROR) ---
LOG_LEVEL=INFO
